{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": { "NEXT_TELEMETRY_DISABLED": "1", "WATCHPACK_POLLING": "true" },
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "autoAllowBashIfSandboxed": false,
    "allowUnsandboxedCommands": false,
    "enableWeakerNetworkIsolation": true,
    "filesystem": {
      "denyRead": [
        "~/",
        "./.[eE][nN][vV]*",
        "./**/.[eE][nN][vV]*",
        "~/.ssh",
        "~/.aws",
        "~/.docker",
        "~/.netrc"
      ],
      "allowRead": [
        "./",
        "./.env.example",
        "~/Library/Application Support/Herd/config/nvm/versions/node",
        "~/.gitconfig",
        "~/.config/git",
        "~/.config/gh",
        "~/Library/Application Support/vitest",
        "~/.claude/shell-snapshots",
        "~/.claude/session-env"
      ],
      "denyWrite": [
        "./.env",
        "./.env.local",
        "./.env.*.local",
        "./.env.development",
        "./.env.test",
        "./.env.production",
        "./.envrc",
        "./.githooks",
        "./node_modules/*",
        "./node_modules/.bin",
        "./node_modules/.pnpm",
        "./node_modules/.modules.yaml"
      ]
    },
    "network": {
      "allowedDomains": [
        "registry.npmjs.org",
        "github.com",
        "api.github.com",
        "fonts.googleapis.com",
        "fonts.gstatic.com"
      ],
      "allowLocalBinding": true
    }
  },
  "permissions": {
    "allow": [
      "Bash(pnpm dev)",
      "Bash(pnpm lint*)",
      "Bash(pnpm typecheck*)",
      "Bash(pnpm test*)",
      "Bash(pnpm verify*)",
      "Bash(pnpm build*)",
      "Bash(pnpm eval:scoring*)",
      "Bash(pnpm db:generate*)",
      "Bash(pnpm format*)",
      "Bash(pnpm exec vitest *)",
      "Bash(pnpm exec tsc *)",
      "Bash(pnpm exec eslint *)",
      "Bash(pnpm exec prettier *)",
      "Bash(pnpm exec playwright test*)",
      "Bash(pnpm audit*)",
      "Bash(pnpm outdated*)",
      "Bash(pnpm list*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git branch*)",
      "Bash(git switch*)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(git stash list*)",
      "Bash(git ls-files*)",
      "Bash(git rev-parse*)",
      "Bash(gh pr view*)",
      "Bash(gh pr list*)",
      "Bash(gh pr checks*)",
      "Bash(gh pr diff*)",
      "Bash(gh run list*)",
      "Bash(gh run view*)",
      "Bash(grep *)",
      "Bash(ls)",
      "Bash(ls *)",
      "Bash(wc *)",
      "Bash(head *)",
      "Bash(awk *)",
      "Bash(bash scripts/test-hooks.sh*)",
      "Bash(bash scripts/test-githooks.sh*)",
      "Bash(bash scripts/test-sandbox.sh*)",
      "WebFetch(domain:code.claude.com)",
      "WebFetch(domain:docs.claude.com)",
      "WebFetch(domain:platform.claude.com)",
      "WebFetch(domain:nextjs.org)",
      "WebFetch(domain:orm.drizzle.team)",
      "WebFetch(domain:www.better-auth.com)",
      "WebFetch(domain:ui.shadcn.com)",
      "WebFetch(domain:zod.dev)",
      "WebFetch(domain:vitest.dev)",
      "WebFetch(domain:playwright.dev)",
      "WebFetch(domain:mswjs.io)",
      "WebFetch(domain:neon.com)",
      "WebFetch(domain:francetravail.io)",
      "WebFetch(domain:developer.adzuna.com)"
    ],
    "ask": [
      "Bash(pnpm add*)",
      "Bash(pnpm install*)",
      "Bash(pnpm remove*)",
      "Bash(pnpm update*)",
      "Bash(pnpm dlx*)",
      "Bash(pnpm db:migrate*)",
      "Bash(git push*)",
      "Bash(git merge*)",
      "Bash(git rebase*)",
      "Bash(git tag*)",
      "Bash(gh pr create*)",
      "Bash(gh pr merge*)",
      "Bash(gh workflow run*)",
      "Bash(gh secret*)",
      "Bash(docker *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.development)",
      "Read(./.env.development.local)",
      "Read(./.env.test)",
      "Read(./.env.test.local)",
      "Read(./.env.production)",
      "Read(./.env.production.local)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(sudo *)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session-context.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-bash.sh",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Read|Edit|Write|MultiEdit|NotebookEdit|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-files.sh",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-code.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/stop-verify.sh",
            "timeout": 10,
            "statusMessage": "Vérification à jour ?"
          }
        ]
      }
    ]
  }
}
