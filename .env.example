# Variables d'environnement de Trouvio — documentation, AUCUNE vraie valeur ici.
# Copier ce fichier en .env.local (jamais commité) et remplir au fil des phases.
# Validation : src/lib/env.ts. Une variable vide vaut « absente » ; seules celles des
# domaines en service (STARTUP_DOMAINS) sont exigées au démarrage.
# NODE_ENV n'apparaît pas : Next et Vitest le fixent eux-mêmes.

# --- core — requis au démarrage en production -------------------------------------
# URL publique de l'application (origine seule). Défaut hors production : http://localhost:3000
APP_URL=http://localhost:3000
# Niveau des journaux (src/lib/logger) : debug | info | warn | error | silent. Vide = info.
LOG_LEVEL=

# --- database — requis à partir de P1-01 ---------------------------------------------
# Console Neon → Connection string, avec le RÔLE APPLICATIF (sans droits DDL).
# Format : postgresql://UTILISATEUR:MOT_DE_PASSE@HOTE/BASE?sslmode=require
DATABASE_URL=

# --- auth — requis côté web à partir de P1-02 ----------------------------------------
# Au moins 32 caractères aléatoires : openssl rand -base64 32
BETTER_AUTH_SECRET=

# --- anthropic — requis côté job à partir de P3-01 ------------------------------------
# console.anthropic.com → API Keys
ANTHROPIC_API_KEY=
# Modèle de scoring (ADR 0005), modifiable sans changer le code.
ANTHROPIC_MODEL_SCORING=claude-haiku-4-5-20251001

# --- franceTravail — requis côté job à partir de P2-02 --------------------------------
# francetravail.io → Mes applications (OAuth2 client credentials)
FRANCE_TRAVAIL_CLIENT_ID=
FRANCE_TRAVAIL_CLIENT_SECRET=

# --- adzuna — requis côté job à partir de P2-03 ---------------------------------------
# developer.adzuna.com → Dashboard
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# --- telegram — requis à partir de P4-02 ----------------------------------------------
# @BotFather → /newbot ; secret du webhook : openssl rand -base64 32
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# --- email — requis à partir de P4-03 (peut-être P1-02 pour le lien magique) -----------
# resend.com → API Keys (domaine d'envoi vérifié). Format : Trouvio <digest@DOMAINE>
RESEND_API_KEY=
EMAIL_FROM=

# --- sentry — optionnel (vide = Sentry désactivé) --------------------------------------
# sentry.io (organisation en région UE) → projet trouvio-dev en local → Client Keys (DSN).
# Format exigé : https://<clé publique>@o<id>.ingest.de.sentry.io/<id projet> (hors UE = refusé).
# Public par nature : figé dans le bundle navigateur au build (next.config.ts). Ne pas poser
# SENTRY_TRACES_SAMPLE_RATE : le démarrage la refuse (traces désactivées, ADR 0010).
SENTRY_DSN=

# --- cron — requis côté web à partir de P10-05 -----------------------------------------
# Secret Bearer de POST /api/cron/run : openssl rand -base64 32
CRON_SECRET=
