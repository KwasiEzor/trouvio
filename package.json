{
  "name": "trouvio",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.13.0",
    "pnpm": ">=10.26.0"
  },
  "scripts": {
    "dev": "next dev",
    "dev:local": "node --env-file=db/local/dev.vars scripts/dev-local.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "e2e:prepare": "tsx scripts/e2e-prepare-db.ts",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check && node scripts/db-check-drift.mjs",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "db:migrate:local": "node --env-file=db/local/dev.vars --import tsx scripts/db-migrate.ts",
    "db:migrate:neon": "node --env-file=.env.local --import tsx scripts/db-migrate.ts",
    "db:seed": "tsx scripts/db-seed.ts",
    "db:seed:local": "node --env-file=db/local/dev.vars --import tsx scripts/db-seed.ts",
    "db:seed:neon": "node --env-file=.env.local --import tsx scripts/db-seed.ts",
    "db:local:up": "docker compose -f db/local/compose.yaml up -d --wait",
    "db:local:down": "docker compose -f db/local/compose.yaml down",
    "verify": "pnpm lint && pnpm typecheck && pnpm db:check && pnpm test:coverage && pnpm format:check && pnpm build",
    "prepare": "node scripts/setup-githooks.mjs"
  },
  "dependencies": {
    "@sentry/core": "11.0.0",
    "@sentry/nextjs": "11.0.0",
    "better-auth": "1.7.7",
    "class-variance-authority": "0.7.1",
    "cn": "0.4.0",
    "drizzle-orm": "0.45.3",
    "lucide-react": "^1.48.0",
    "next": "16.3.8",
    "pg": "^8.23.0",
    "radix-ui": "^1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.4",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "5.0.2",
    "@vitest/eslint-plugin": "^1.6.27",
    "drizzle-kit": "0.31.11",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.6",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-better-tailwindcss": "^4.7.0",
    "eslint-plugin-playwright": "^2.12.0",
    "jsdom": "^29.1.1",
    "msw": "^2.15.0",
    "postcss": "^8.5.28",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vite": "^8.3.1",
    "vitest": "5.0.2"
  }
}
